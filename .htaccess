<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Jangan rewrite request ke backend
    RewriteRule ^backend/ - [L,NC]

    # Lewati file dan direktori fisik yang benar-benar ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Rewrite semua route SPA ke index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Proteksi file .env dan file sensitif (kompatibel Apache 2.4 & 2.2 Wuaze/InfinityFree)
<FilesMatch "^(\.env|\.git|\.env\..*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|log|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>